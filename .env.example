# FreeCodeAI — Free Provider API Keys
# Get each key from the URL listed below (all free, no credit card)

# Optional: gateway settings (uncomment to override defaults)
# PORT=3377
# DASHBOARD_PORT=3378
# STRATEGY=auto   # auto | round-robin | speed-first | quality-first | validate

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# GitHub Models — https://github.com/settings/tokens
GITHUB_TOKEN=

# NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com/
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# SambaNova — https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HF_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Chutes.ai — https://chutes.ai/
CHUTES_API_KEY=

# Alibaba/Qwen — https://dashscope.aliyuncs.com/
QWEN_API_KEY=

# OVHcloud AI — https://endpoints.ai.cloud.ovh.net/
OVHCLOUD_API_KEY=
